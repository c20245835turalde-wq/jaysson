---
const services = [
	{
		number: '01',
		title: 'Brand identity',
		description: 'Strategy, naming, and visual systems that make your brand unmistakable.',
	},
	{
		number: '02',
		title: 'Digital experiences',
		description: 'Thoughtful websites and digital products, designed to work beautifully.',
	},
	{
		number: '03',
		title: 'Campaigns & content',
		description: 'Clear, characterful creative that gets the right people talking.',
	},
];

const steps = [
	{
		number: '01',
		title: 'Listen',
		description: 'We get to know your goals, your audience, and what makes you different.',
	},
	{
		number: '02',
		title: 'Find the spark',
		description: 'We turn the big questions into a clear strategy and a shared direction.',
	},
	{
		number: '03',
		title: 'Make it real',
		description: 'We build, refine, and launch work made to keep making an impact.',
	},
];

const projects = [
	{
		number: '01',
		name: 'Good Goods',
		type: 'Brand identity · E-commerce',
		className: 'goods',
		graphicLines: ['GOOD', 'GOODS'],
		descriptor: 'Better things, made better.',
	},
	{
		number: '02',
		name: 'Fieldnotes',
		type: 'Digital experience · Art direction',
		className: 'fieldnotes',
		graphicLines: ['FIELD', 'NOTES'],
		descriptor: 'A little closer to outside.',
	},
	{
		number: '03',
		name: 'Off Hours',
		type: 'Strategy · Campaign',
		className: 'offhours',
		graphicLines: ['OFF', 'HOURS'],
		descriptor: 'Make room for your own time.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="VOLT is an independent creative studio building distinct brands and digital experiences."
		/>
		<meta name="theme-color" content="#f5f4ee" />
		<title>VOLT Studio — Make good ideas impossible to ignore</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="#home" aria-label="VOLT Studio home">
				<img src="/volt-mark.png" alt="" width="42" height="42" />
				<span>VOLT<span class="brand-dot">.</span></span>
			</a>
			<nav class="desktop-nav" aria-label="Main navigation">
				<a href="#services">Services</a>
				<a href="#process">Process</a>
				<a href="#about">About</a>
				<a href="#projects">Projects</a>
			</nav>
			<a class="header-cta" href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
			<details class="mobile-nav">
				<summary>Menu <span aria-hidden="true">+</span></summary>
				<nav aria-label="Mobile navigation">
					<a href="#services">Services</a>
					<a href="#process">Process</a>
					<a href="#about">About</a>
					<a href="#projects">Projects</a>
					<a href="#contact">Contact</a>
				</nav>
			</details>
		</header>

		<main>
			<section class="hero section-wrap" id="home">
				<div class="hero-copy">
					<p class="eyebrow"><span class="status-dot"></span> Independent creative studio</p>
					<h1>Make good ideas <span>impossible</span> to ignore.</h1>
					<div class="hero-bottom">
						<p class="hero-intro">
							We build brave brands and digital experiences for people ready to do things
							differently.
						</p>
						<a class="text-link" href="#projects">Explore our work <span aria-hidden="true">↓</span></a>
					</div>
				</div>
				<div class="hero-art" aria-label="VOLT Studio logo artwork">
					<div class="art-topline"><span>V / 001</span><span>Ideas in motion</span></div>
					<img src="/volt-mark.png" alt="Black V and lightning bolt logo" />
					<div class="art-caption"><span>VOLT®</span><span>Est. for what’s next</span></div>
					<span class="art-spark" aria-hidden="true">✳</span>
				</div>
				<div class="hero-meta">
					<span>Strategy / Identity / Digital</span>
					<a href="#services">Scroll to explore <span aria-hidden="true">↓</span></a>
				</div>
			</section>

			<section class="services section-wrap section-pad" id="services">
				<div class="section-heading">
					<p class="eyebrow">01 / What we do</p>
					<h2>Good work starts<br />with <span class="serif">good questions.</span></h2>
					<p class="section-note">
						From first thought to final detail, we bring the right mix of clarity and
						creative energy.
					</p>
				</div>
				<div class="service-list">
					{services.map((service) => (
						<article class="service-row">
							<span class="row-number">{service.number}</span>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
							<span class="row-arrow" aria-hidden="true">↗</span>
						</article>
					))}
				</div>
			</section>

			<section class="process section-wrap section-pad" id="process">
				<div class="process-head">
					<div>
						<p class="eyebrow">02 / How we work</p>
						<h2>Clear thinking.<br /><span class="serif">Good momentum.</span></h2>
					</div>
					<p>
						No mystery process. Just good people, open collaboration, and a clear path
						from the first hello to the final handoff.
					</p>
				</div>
				<div class="steps">
					{steps.map((step) => (
						<article class="step">
							<span class="step-number">{step.number}</span>
							<div class="step-mark" aria-hidden="true">↗</div>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</article>
					))}
				</div>
				<div class="process-foot"><span>Curious minds welcome</span><span>Built together, every step</span></div>
			</section>

			<section class="about section-wrap section-pad" id="about">
				<div class="about-label">
					<p class="eyebrow">03 / A little about us</p>
					<div class="about-stamp" aria-hidden="true">
						<img src="/volt-mark.png" alt="" />
						<span>GOOD<br />ENERGY<br />ONLY</span>
					</div>
				</div>
				<div class="about-copy">
					<h2>Small by design.<br />Big on <span class="serif">what matters.</span></h2>
					<p class="about-lead">
						VOLT is an independent creative studio partnering with ambitious people to
						make brands mean more.
					</p>
					<p>
						We bring strategy and design together, keeping the team close and the work
						thoughtful. No layers, no noise — just a shared belief that the best ideas
						are the ones that move things forward.
					</p>
					<a class="text-link" href="#contact">A good place to start <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="projects section-wrap section-pad" id="projects">
				<div class="projects-heading">
					<div>
						<p class="eyebrow">04 / Selected projects</p>
						<h2>Made with <span class="serif">intention.</span></h2>
					</div>
					<p>A few ideas, brought to life with good people.</p>
				</div>
				<div class="project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div class:list={['project-art', project.className]}>
								<div class="project-art-top"><span>VOLT®</span><span>{project.number} / 03</span></div>
								<p class="project-graphic">
									{project.graphicLines.map((line) => <span>{line}</span>)}
								</p>
								<span class="project-descriptor">{project.descriptor}</span>
								<span class="project-art-arrow" aria-hidden="true">↗</span>
							</div>
							<div class="project-info">
								<div><h3>{project.name}</h3><p>{project.type}</p></div>
								<span aria-hidden="true">↗</span>
							</div>
						</article>
					))}
				</div>
				<p class="work-note">Project visuals shown as creative studies. Your next story could be here.</p>
			</section>

			<section class="contact section-wrap" id="contact">
				<div class="contact-top">
					<p class="eyebrow">05 / Your turn</p>
					<span class="contact-spark" aria-hidden="true">✳</span>
				</div>
				<h2>Got a good one<br />in <span class="serif">mind?</span></h2>
				<div class="contact-bottom">
					<p>Tell us what you’re thinking. We’ll bring the good questions.</p>
					<a class="contact-link" href="mailto:hello@volt.studio">
						Start a conversation <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>
		</main>

		<footer class="site-footer section-wrap">
			<a class="brand footer-brand" href="#home" aria-label="VOLT Studio home">
				<img src="/volt-mark.png" alt="" width="36" height="36" />
				<span>VOLT<span class="brand-dot">.</span></span>
			</a>
			<p>Independent by nature. Creative by choice.</p>
			<a href="#home">Back to top ↑</a>
			<span>© {new Date().getFullYear()} VOLT Studio</span>
		</footer>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--paper: #f5f4ee;
		--ink: #171815;
		--muted: #73746c;
		--line: #d8d8cf;
		--lime: #d8ff54;
		--green: #2b5b40;
		--display: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
		--body: "Helvetica Neue", Helvetica, Arial, sans-serif;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		scroll-padding-top: 90px;
	}

	:global(body) {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--body);
		-webkit-font-smoothing: antialiased;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(a:focus-visible),
	:global(summary:focus-visible) {
		outline: 2px solid var(--green);
		outline-offset: 5px;
	}

	.site-header,
	.section-wrap {
		width: min(100% - 96px, 1440px);
		margin-inline: auto;
	}

	.site-header {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 88px;
		border-bottom: 1px solid var(--line);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 19px;
		font-weight: 850;
		letter-spacing: -0.08em;
	}

	.brand img {
		width: 39px;
		height: 39px;
		object-fit: contain;
		mix-blend-mode: multiply;
	}

	.brand-dot {
		color: var(--green);
	}

	.desktop-nav {
		display: flex;
		gap: clamp(20px, 3vw, 46px);
		margin-left: 9%;
		font-size: 12px;
		font-weight: 600;
	}

	.desktop-nav a,
	.site-footer a,
	.header-cta,
	.text-link {
		transition: opacity 180ms ease;
	}

	.desktop-nav a:hover,
	.site-footer a:hover,
	.header-cta:hover,
	.text-link:hover {
		opacity: 0.6;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		padding: 13px 17px;
		border-radius: 2px;
		background: var(--ink);
		color: white;
		font-size: 12px;
	}

	.header-cta span {
		color: var(--lime);
		font-size: 16px;
	}

	.mobile-nav {
		display: none;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
		column-gap: 6%;
		padding-top: clamp(75px, 11vw, 158px);
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.eyebrow {
		margin: 0;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.status-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		margin-right: 7px;
		border-radius: 50%;
		background: #8cae48;
		vertical-align: 1px;
		box-shadow: 0 0 0 3px #8cae4822;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 760px;
		margin-bottom: 40px;
		font-family: var(--display);
		font-size: clamp(68px, 9.3vw, 136px);
		font-weight: 700;
		letter-spacing: -0.085em;
		line-height: 0.86;
	}

	h1 span {
		color: var(--green);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.83em;
		font-weight: 400;
		font-style: italic;
		letter-spacing: -0.09em;
	}

	.hero-bottom {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 22px;
		max-width: 560px;
	}

	.hero-intro {
		max-width: 300px;
		margin-bottom: 0;
		color: #4f5049;
		font-size: 14px;
		line-height: 1.65;
	}

	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		padding-bottom: 6px;
		border-bottom: 1px solid currentColor;
		font-size: 11px;
		font-weight: 650;
		white-space: nowrap;
	}

	.hero-art {
		position: relative;
		display: flex;
		min-height: 440px;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		padding: 19px;
		background: var(--lime);
	}

	.hero-art::before,
	.hero-art::after {
		position: absolute;
		width: 360px;
		height: 360px;
		border: 1px solid #17181524;
		border-radius: 50%;
		content: "";
	}

	.hero-art::before {
		top: 12%;
		left: 10%;
	}

	.hero-art::after {
		top: 18%;
		left: 17%;
	}

	.art-topline,
	.art-caption {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: space-between;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.hero-art img {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 43%;
		max-width: 190px;
		transform: translate(-50%, -50%);
		mix-blend-mode: multiply;
	}

	.art-spark {
		position: absolute;
		top: 28%;
		right: 13%;
		font-size: 30px;
	}

	.hero-meta {
		grid-column: 1 / -1;
		display: flex;
		justify-content: space-between;
		margin-top: clamp(50px, 8vw, 108px);
		padding-bottom: 18px;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 9px;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.hero-meta a {
		color: var(--ink);
	}

	.section-pad {
		padding-block: clamp(100px, 13vw, 180px);
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr 0.75fr;
		align-items: end;
		column-gap: 8%;
		margin-bottom: 60px;
	}

	.section-heading .eyebrow {
		grid-column: 1 / -1;
		margin-bottom: 34px;
	}

	h2 {
		margin-bottom: 0;
		font-family: var(--display);
		font-size: clamp(43px, 6vw, 82px);
		font-weight: 650;
		letter-spacing: -0.075em;
		line-height: 0.94;
	}

	.serif {
		color: var(--green);
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 400;
		font-style: italic;
		letter-spacing: -0.08em;
	}

	.section-note {
		max-width: 300px;
		margin-bottom: 5px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.7;
	}

	.service-list {
		border-top: 1px solid var(--line);
	}

	.service-row {
		display: grid;
		grid-template-columns: 0.18fr 1fr 0.7fr 20px;
		align-items: center;
		gap: 20px;
		min-height: 112px;
		border-bottom: 1px solid var(--line);
	}

	.row-number {
		color: var(--muted);
		font-size: 10px;
	}

	.service-row h3 {
		margin: 0;
		font-size: clamp(22px, 3vw, 34px);
		font-weight: 550;
		letter-spacing: -0.055em;
	}

	.service-row p {
		max-width: 320px;
		margin: 0;
		color: var(--muted);
		font-size: 12px;
		line-height: 1.6;
	}

	.row-arrow {
		font-size: 18px;
	}

	.process {
		padding-inline: clamp(25px, 7vw, 96px);
		background: var(--ink);
		color: var(--paper);
	}

	.process-head,
	.projects-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 40px;
	}

	.process-head .eyebrow,
	.projects-heading .eyebrow {
		margin-bottom: 30px;
		color: #a4a69d;
	}

	.process h2 .serif {
		color: var(--lime);
	}

	.process-head > p {
		max-width: 305px;
		margin-bottom: 4px;
		color: #b6b7b0;
		font-size: 12px;
		line-height: 1.7;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
		margin-top: 90px;
	}

	.step {
		position: relative;
		min-height: 250px;
		padding: 22px 18px 20px 0;
		border-top: 1px solid #ffffff3d;
	}

	.step-number {
		color: #a4a69d;
		font-size: 10px;
	}

	.step-mark {
		position: absolute;
		top: 13px;
		right: 12px;
		color: var(--lime);
		font-size: 20px;
	}

	.step h3 {
		margin: 70px 0 12px;
		font-size: 28px;
		font-weight: 500;
		letter-spacing: -0.05em;
	}

	.step p {
		max-width: 250px;
		margin: 0;
		color: #b6b7b0;
		font-size: 12px;
		line-height: 1.7;
	}

	.process-foot {
		display: flex;
		justify-content: space-between;
		padding-top: 14px;
		border-top: 1px solid #ffffff3d;
		color: #a4a69d;
		font-size: 9px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.about {
		display: grid;
		grid-template-columns: 0.75fr 1.25fr;
		gap: 12%;
	}

	.about-label {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		min-height: 390px;
	}

	.about-stamp {
		position: relative;
		display: grid;
		width: 190px;
		height: 190px;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
	}

	.about-stamp img {
		width: 84px;
		height: 84px;
		object-fit: contain;
		opacity: 0.1;
		mix-blend-mode: multiply;
	}

	.about-stamp span {
		position: absolute;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-align: center;
	}

	.about-copy h2 {
		margin-bottom: 42px;
	}

	.about-lead {
		max-width: 540px;
		margin-bottom: 18px;
		font-size: clamp(19px, 2.2vw, 27px);
		font-weight: 450;
		letter-spacing: -0.04em;
		line-height: 1.3;
	}

	.about-copy > p:not(.about-lead) {
		max-width: 490px;
		margin-bottom: 30px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.8;
	}

	.projects {
		padding-top: 0;
	}

	.projects-heading {
		margin-bottom: 45px;
	}

	.projects-heading > p {
		margin-bottom: 6px;
		color: var(--muted);
		font-size: 12px;
	}

	.projects-heading .eyebrow {
		color: var(--muted);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
	}

	.project-art {
		position: relative;
		display: flex;
		min-height: clamp(240px, 31vw, 430px);
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		padding: 17px;
	}

	.goods {
		background: #e6dfcd;
		color: #274c37;
	}

	.fieldnotes {
		background: #b9cfb8;
		color: #263d2d;
	}

	.offhours {
		background: #d1a287;
		color: #352a27;
	}

	.project-art-top {
		display: flex;
		justify-content: space-between;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.project-graphic {
		position: relative;
		z-index: 1;
		margin: 0;
		font-family: var(--display);
		font-size: clamp(42px, 6.3vw, 88px);
		font-weight: 800;
		letter-spacing: -0.09em;
		line-height: 0.76;
	}

	.project-graphic span {
		display: block;
	}

	.goods .project-graphic {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(45px, 6vw, 82px);
		font-weight: 700;
		font-style: italic;
		letter-spacing: -0.1em;
	}

	.fieldnotes .project-graphic {
